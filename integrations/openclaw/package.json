{
  "name": "openclaw-plugin-vmga",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --root . --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --root . --entry ./dist/index.js",
    "test": "vitest run src"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.6.5"
  },
  "dependencies": {
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "openclaw": "2026.10.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "overrides": {
    "openclaw": {
      "npm": "12.2.1",
      "undici": "8.12.2",
      "zod": "4.6.6"
    }
  }
}
